# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Static Wi-Fi Anchor Configuration (JSON or comma-separated)
# Format: BSSID:x,y,z,P0
ANCHOR_1_BSSID=aa:bb:cc:11:22:33
ANCHOR_1_X=0.0
ANCHOR_1_Y=0.0
ANCHOR_1_Z=1.5
ANCHOR_1_P0=-40

ANCHOR_2_BSSID=aa:bb:cc:44:55:66
ANCHOR_2_X=10.0
ANCHOR_2_Y=0.0
ANCHOR_2_Z=1.5
ANCHOR_2_P0=-40

ANCHOR_3_BSSID=aa:bb:cc:77:88:99
ANCHOR_3_X=5.0
ANCHOR_3_Y=10.0
ANCHOR_3_Z=1.5
ANCHOR_3_P0=-40

# Sensor Fusion Parameters
PATH_LOSS_EXPONENT=2.5
NUM_PARTICLES=1000
VOXEL_RESOLUTION_M=0.25

# MongoDB connection string (Atlas or local). Database name defaults to cloudscan.
MONGODB_URI=
MONGODB_DB=cloudscan

# Tracker -> CloudScan save. A finished walk is posted to /api/explorations.
CLOUDSCAN_URL=http://127.0.0.1:3000
BUILDING_ID=explored
BUILDING_LAT=42.7298
BUILDING_LNG=-73.6789
BUILDING_ADDRESS=Explored structure

