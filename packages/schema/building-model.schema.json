{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "photo",
        "address",
        "wifi",
        "upload",
        "demo"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "address": {
      "default": "",
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "footprint": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2,
        "description": "[x, y] in meters"
      },
      "description": "Closed ring, no repeated last point"
    },
    "floors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "-1 basement, 0 ground, 1 second floor, ..."
          },
          "name": {
            "type": "string"
          },
          "elevation": {
            "type": "number"
          },
          "height": {
            "default": 2.7,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rooms": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "living",
                    "kitchen",
                    "dining",
                    "bedroom",
                    "bathroom",
                    "hallway",
                    "stair",
                    "garage",
                    "utility",
                    "closet",
                    "office",
                    "basement",
                    "other"
                  ]
                },
                "polygon": {
                  "minItems": 3,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[x, y] in meters"
                  },
                  "description": "Closed ring, no repeated last point"
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "polygon"
              ]
            }
          },
          "walls": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "a": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in meters"
                },
                "b": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in meters"
                },
                "thickness": {
                  "default": 0.15,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "exterior": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "a",
                "b"
              ]
            }
          },
          "doors": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "wallId": {
                  "type": "string"
                },
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Position of door center along the wall, 0 = a, 1 = b"
                },
                "width": {
                  "default": 0.9,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "exit": {
                  "default": false,
                  "description": "True if it leads outside",
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "wallId",
                "t"
              ]
            }
          },
          "stairs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "polygon": {
                  "minItems": 3,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[x, y] in meters"
                  },
                  "description": "Closed ring, no repeated last point"
                },
                "toLevel": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "polygon",
                "toLevel"
              ]
            }
          }
        },
        "required": [
          "level",
          "name",
          "elevation"
        ]
      }
    },
    "markers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "fire",
              "victim",
              "gas",
              "shutoff",
              "hazard",
              "entry"
            ]
          },
          "floor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "pos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, y] in meters"
          },
          "note": {
            "default": "",
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp"
          }
        },
        "required": [
          "id",
          "type",
          "floor",
          "pos",
          "createdAt"
        ]
      }
    },
    "roof": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "gable",
            "hip",
            "flat",
            "gambrel",
            "mansard",
            "other"
          ]
        },
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "[x, y] in meters"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number",
          "description": "Radians, counter-clockwise from +x (east)"
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Rise above the top floor's ceiling, meters"
        },
        "polygon": {
          "description": "Eaves outline; when set, the roof follows this instead of a rectangle",
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, y] in meters"
          }
        },
        "ridgeAlong": {
          "description": "Axis the ridge runs along in the plan frame",
          "type": "string",
          "enum": [
            "width",
            "depth"
          ]
        },
        "plan": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "flat",
                "gable",
                "hip",
                "wings"
              ]
            },
            "wings": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "polygon": {
                    "minItems": 3,
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[x, y] in meters"
                    },
                    "description": "Closed ring, no repeated last point"
                  },
                  "ridge": {
                    "description": "Ridge segment in the model frame; omit for flat",
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "[x, y] in meters"
                      },
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "[x, y] in meters"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  },
                  "shape": {
                    "type": "string",
                    "enum": [
                      "gable",
                      "hip",
                      "flat"
                    ]
                  }
                },
                "required": [
                  "polygon",
                  "height",
                  "shape"
                ]
              }
            },
            "source": {
              "description": "What decided the plan, e.g. map, aerial, footprint",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "wings"
          ]
        },
        "basis": {
          "description": "Generation tag — bump when roof meshing/inference changes so old scans auto-rebuild",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "center",
        "width",
        "depth",
        "rotation",
        "height"
      ]
    },
    "interior": {
      "description": "Absent on old scans and the demo house",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "estimated",
            "unknown"
          ]
        },
        "source": {
          "description": "Where the rooms came from, e.g. 'floor plan' or 'typical layout'",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "description": "Why a measured interior is missing",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownLevels": {
          "default": [],
          "description": "Floors whose rooms come from a real source",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "notes": {
          "default": [],
          "description": "Caveats, e.g. placement unconfirmed",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ]
    },
    "compound": {
      "description": "Lot, outbuildings, and surfaces around the house. Absent on older scans.",
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "yard",
                  "garage",
                  "shed",
                  "driveway",
                  "patio",
                  "pool",
                  "fence",
                  "trees",
                  "road",
                  "signal",
                  "hydrant"
                ]
              },
              "label": {
                "type": "string"
              },
              "polygon": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in meters"
                },
                "description": "Closed ring, no repeated last point"
              },
              "height": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "source": {
                "type": "string",
                "enum": [
                  "map",
                  "aerial",
                  "parcel"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "polygon",
              "source"
            ]
          }
        },
        "basis": {
          "description": "Set when the lot, street, and driveway pass has run",
          "type": "string"
        }
      },
      "required": [
        "features"
      ]
    }
  },
  "required": [
    "id",
    "source",
    "confidence",
    "lat",
    "lng",
    "footprint",
    "floors"
  ]
}
